<Window x:Class="AzulGroove.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Azul Groove Music" Icon="icon.ico" Width="1280" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{StaticResource Abyss}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Foreground="{StaticResource Foam}" FontFamily="Segoe UI Variable Text, Segoe UI"
        AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_KeyDown" PreviewMouseMove="Window_MouseMove"
        StateChanged="Window_StateChanged" Closing="Window_Closing" Loaded="Window_Loaded">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <ContextMenu x:Key="CardMenu">
      <MenuItem Header="Reproduzir" Click="PlayMenu_Click"/>
      <MenuItem Header="Tocar a seguir" Click="PlayNextMenu_Click"/>
      <MenuItem Header="Adicionar à fila" Click="QueueMenu_Click"/>
      <MenuItem Header="Adicionar à playlist" SubmenuOpened="AddToPlaylistMenu_Opened"><MenuItem Header="…"/></MenuItem>
      <MenuItem Header="Mostrar na pasta" Click="Reveal_Click"/>
      <MenuItem Header="Editar informações…" Click="EditTags_Click"/>
      <Separator/>
      <MenuItem Header="Remover da biblioteca" Click="Remove_Click"/>
    </ContextMenu>
    <ContextMenu x:Key="PlaylistMenu">
      <MenuItem Header="Reproduzir" Click="PlayPlaylistMenu_Click"/>
      <MenuItem Header="Adicionar à fila" Click="QueuePlaylistMenu_Click"/>
      <MenuItem Header="Renomear" Click="RenamePlaylistMenu_Click"/>
      <MenuItem Header="Exportar como .m3u…" Click="ExportPlaylistMenu_Click"/>
      <Separator/>
      <MenuItem Header="Excluir" Click="DeletePlaylistMenu_Click"/>
    </ContextMenu>
    <DataTemplate x:Key="CardT">
      <Button x:Name="Card" Style="{StaticResource CardBtn}" Click="Card_Click" Loaded="Card_Loaded" ContextMenu="{StaticResource CardMenu}" Margin="0,0,24,28" Width="176">
        <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
        <StackPanel>
          <Grid Width="176" Height="176">
            <Border CornerRadius="16" Background="{Binding Art, IsAsync=True, FallbackValue={StaticResource ArtPlaceholder}}" BorderBrush="#26FFFFFF" BorderThickness="1">
            </Border>
            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="52" Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="9,3" CornerRadius="8" Background="#E6051433">
              <TextBlock Text="{Binding Kind}" FontSize="11.5" Foreground="White"/>
            </Border>
            <Border x:Name="Ring" CornerRadius="16" BorderBrush="{StaticResource Cyan}" BorderThickness="2.5" Visibility="Collapsed"/>
            <Border x:Name="Badge" Width="34" Height="34" CornerRadius="17" Background="{StaticResource Grad}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Visibility="Collapsed">
              <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <TextBlock Text="{Binding Name}" Margin="3,12,0,0" FontSize="14" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Subtitle}" Margin="3,4,0,0" FontSize="11.5" Foreground="{StaticResource Mute}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
          <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="pulse"><Storyboard Timeline.DesiredFrameRate="30">
              <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard></BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="pulse"/></DataTrigger.ExitActions>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="VirtualizedRows">
      <VirtualizingStackPanel/>
    </ItemsPanelTemplate>
    <DataTemplate x:Key="CardRowT">
      <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource CardT}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.Background>
      <RadialGradientBrush Center="0.78,0" GradientOrigin="0.78,0" RadiusX="0.95" RadiusY="0.95">
        <GradientStop Color="#123A85" Offset="0"/><GradientStop Color="#0A2150" Offset="0.45"/><GradientStop Color="#050E24" Offset="1"/>
      </RadialGradientBrush>
    </Grid.Background>
    <!-- Luzes azuis à deriva: gradientes prontos (sem blur) e em cache, bem leves -->
    <Grid IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse Width="900" Height="900" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="180,-430,0,0">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#A03B82FF" Offset="0"/><GradientStop Color="#003B82FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.CacheMode><BitmapCache RenderAtScale="0.4"/></Ellipse.CacheMode>
        <Ellipse.RenderTransform><TranslateTransform x:Name="ShA"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="780" Height="780" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-220,-280">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#8000B7FF" Offset="0"/><GradientStop Color="#0000B7FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.CacheMode><BitmapCache RenderAtScale="0.4"/></Ellipse.CacheMode>
        <Ellipse.RenderTransform><TranslateTransform x:Name="ShB"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="720" Height="720" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-200,0,0,-300">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#702F8CFF" Offset="0"/><GradientStop Color="#002F8CFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.CacheMode><BitmapCache RenderAtScale="0.4"/></Ellipse.CacheMode>
        <Ellipse.RenderTransform><TranslateTransform x:Name="ShC"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="640" Height="640" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-120,0">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#604FD1FF" Offset="0"/><GradientStop Color="#004FD1FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.CacheMode><BitmapCache RenderAtScale="0.4"/></Ellipse.CacheMode>
        <Ellipse.RenderTransform><TranslateTransform x:Name="ShD"/></Ellipse.RenderTransform>
      </Ellipse>
    </Grid>
<Grid>
      <Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="44"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <!-- Barra de título -->
      <Grid x:Name="TitleBar" Grid.Row="0">
        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
          <Button Style="{StaticResource IconBtn}" Width="34" Height="34" FontSize="13" Content="&#xE72B;" Click="Back_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Image x:Name="TitleIcon" Width="22" Height="22" Margin="12,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Azul Groove Music" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource CapBtn}" Content="&#xE921;" Click="Min_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="MaxBtn" Style="{StaticResource CapBtn}" Content="&#xE922;" Click="Max_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Style="{StaticResource CapBtn}" Tag="{StaticResource CloseHover}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
      </Grid>

      <!-- Corpo -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SideCol" Width="290"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border x:Name="Side" Grid.Column="0" Background="#99061431" BorderBrush="#1A78AAFF" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Margin="16,10,16,14" CornerRadius="12" Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Height="40">
              <Grid>
                <TextBlock x:Name="Ph" Text="Pesquisar" Foreground="{StaticResource Mute}" VerticalAlignment="Center" Margin="14,0" IsHitTestVisible="False"/>
                <TextBox x:Name="Search" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Foam}" CaretBrush="{StaticResource Cyan}" FocusVisualStyle="{StaticResource FocusRing}" VerticalContentAlignment="Center" Margin="10,0,36,0" TextChanged="Search_Changed"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Mute}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,0,6">
            <StackPanel>
              <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" GroupName="nav" Uid="0" Tag="&#xE80F;" Content="Início" IsChecked="True" Checked="Nav_Checked"/>
              <RadioButton x:Name="NavMusic" Style="{StaticResource Nav}" GroupName="nav" Uid="1" Tag="&#xE8D6;" Content="Biblioteca de músicas" Checked="Nav_Checked"/>
              <RadioButton x:Name="NavVideo" Style="{StaticResource Nav}" GroupName="nav" Uid="2" Tag="&#xE714;" Content="Biblioteca de vídeos" Checked="Nav_Checked"/>
              <RadioButton x:Name="NavArtists" Style="{StaticResource Nav}" GroupName="nav" Uid="7" Tag="&#xE77B;" Content="Artistas" Checked="Nav_Checked" Click="NavGroup_Click"/>
              <RadioButton x:Name="NavAlbums" Style="{StaticResource Nav}" GroupName="nav" Uid="8" Tag="&#xE93C;" Content="Álbuns" Checked="Nav_Checked" Click="NavGroup_Click"/>
              <Rectangle Height="1" Fill="#1F78AAFF" Margin="18,10"/>
              <RadioButton x:Name="NavQueue" Style="{StaticResource Nav}" GroupName="nav" Uid="3" Tag="&#xE8FD;" Content="Fila de reprodução" Checked="Nav_Checked"/>
              <RadioButton x:Name="NavNow" Style="{StaticResource Nav}" GroupName="nav" Uid="4" Tag="&#xE768;" Content="Tocando agora" Checked="Nav_Checked"/>
              <RadioButton x:Name="NavPlaylists" Style="{StaticResource Nav}" GroupName="nav" Uid="5" Tag="&#xE8A5;" Content="Playlists" Checked="Nav_Checked"/>
              <RadioButton x:Name="NavYouTube" Style="{StaticResource Nav}" GroupName="nav" Uid="6" Tag="&#xE896;" Content="YouTube" Checked="Nav_Checked"/>
            </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="16,0,16,16">
              <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" GroupName="nav" Uid="9" Tag="&#xE713;" Content="Configurações" Checked="Nav_Checked" Margin="-16,0,-16,6"/>
              <Button Style="{StaticResource PillBtn}" Content="Abrir pasta" Click="Folder_Click" Margin="0,0,0,8"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Animação do Início: ondas e partículas (montadas em código) -->
        <Grid x:Name="FxLayer" Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True"/>
        <Grid x:Name="ContentHost" Grid.Column="1" Margin="40,18,24,0">
          <!-- Bibliotecas -->
          <Grid x:Name="LibView" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TranslateTransform x:Name="LibShift"/></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid x:Name="Head" Margin="0,0,16,22">
              <StackPanel>
                <TextBlock x:Name="PageTitle" Text="Início" FontSize="40" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageSub" Text="Mídia recente" FontSize="17" FontWeight="SemiBold" Margin="2,26,0,0"/>
                <StackPanel x:Name="ScanStatus" Orientation="Horizontal" Visibility="Collapsed" Margin="2,12,0,0">
                  <ProgressBar x:Name="ScanBar" Width="190" Height="8" VerticalAlignment="Center" IsIndeterminate="True"/>
                  <TextBlock x:Name="ScanText" Text="Lendo arquivos..." FontSize="12" Foreground="{StaticResource Mute}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0">
                <ComboBox x:Name="SortBox" Width="150" Height="36" SelectedIndex="0" SelectionChanged="Sort_Changed" FocusVisualStyle="{StaticResource FocusRing}"
                          ToolTip="Ordenar por" Margin="0,0,10,0">
                  <ComboBoxItem Content="Nome"/>
                  <ComboBoxItem Content="Data do arquivo"/>
                  <ComboBoxItem Content="Duração"/>
                </ComboBox>
                <Button x:Name="GroupBack" Style="{StaticResource PillBtn}" Content="‹  Voltar" Visibility="Collapsed" Click="GroupBack_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource PillBtn}" Content="Atualizar biblioteca" ToolTip="Procurar arquivos novos, alterados ou removidos" Click="RefreshLibrary_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource PillBtn}" Content="Abrir arquivo(s)" Click="Files_Click"/>
              </StackPanel>
            </Grid>
            <!-- Resultados do YouTube (busca) -->
            <Border x:Name="YtSearchPanel" Grid.Row="1" Visibility="Collapsed" Margin="2,0,16,14" Padding="14,10" CornerRadius="12" Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1">
              <StackPanel>
                <Grid>
                  <TextBlock Text="No YouTube" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                  <TextBlock x:Name="YtSearchStatus" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Mute}"/>
                </Grid>
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,8,0,0">
                  <ItemsControl x:Name="YtResults" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,3,10,3">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Foam}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Mute}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="12" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PillBtn}" Padding="12,6" FontSize="12" Content="Ouvir" ToolTip="Toca agora, sem baixar" IsEnabled="{Binding CanListen}" Click="YtResultListen_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource PillBtn}" Padding="12,6" FontSize="12" Content="Baixar áudio" ToolTip="Baixa como MP3 para o aparelho" IsEnabled="{Binding CanDownload}" Click="YtResultAudio_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource PillBtn}" Padding="12,6" FontSize="12" Content="Vídeo" ToolTip="Baixa o vídeo em MP4 para o aparelho" IsEnabled="{Binding CanDownload}" Click="YtResultVideo_Click"/>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
            <ListBox x:Name="Cards" VirtualizingPanel.ScrollUnit="Pixel" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="2,4,0,20"
                     ItemsPanel="{StaticResource VirtualizedRows}" ItemTemplate="{StaticResource CardRowT}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     Loaded="Cards_Loaded" SizeChanged="Cards_SizeChanged">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ItemPlain}">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderThickness" Value="0"/>
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
            <StackPanel x:Name="Empty" Grid.Row="2" Visibility="Collapsed" Margin="2,10,0,0">
              <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="54" Foreground="{StaticResource Cyan}" HorizontalAlignment="Left" Margin="0,0,0,14">
                <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                <TextBlock.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="30">
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-12" Duration="0:0:1.6"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="1" Duration="0:0:1.6"/>
                  </Storyboard>
                </BeginStoryboard></EventTrigger></TextBlock.Triggers>
              </TextBlock>
              <TextBlock Text="Nada por aqui ainda.&#x0A;Arraste músicas e vídeos para a janela ou use “Abrir arquivo(s)”." Foreground="{StaticResource Mute}" FontSize="15" LineHeight="26"/>
            </StackPanel>
          </Grid>

          <!-- Fila de reprodução -->
          <Grid x:Name="QueueView" Visibility="Collapsed" Margin="40,18,24,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,16,22">
              <StackPanel>
                <TextBlock Text="Fila de reprodução" FontSize="40" FontWeight="SemiBold"/>
                <TextBlock x:Name="QueueSummary" Text="Próximas faixas" FontSize="17" FontWeight="SemiBold" Margin="2,26,0,0"/>
              </StackPanel>
              <Button Style="{StaticResource PillBtn}" Content="Limpar fila" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0" Click="ClearQueue_Click"/>
            </Grid>
            <Grid Grid.Row="1">
              <ListBox x:Name="QueueItems" VirtualizingPanel.ScrollUnit="Pixel" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Foam}" FocusVisualStyle="{StaticResource FocusRing}" AllowDrop="True"
                       PreviewMouseLeftButtonDown="Queue_MouseDown" PreviewMouseMove="Queue_MouseMove"
                       DragOver="Queue_DragOver" Drop="Queue_Drop" MouseDoubleClick="Queue_DoubleClick">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource ItemSoft}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,16,10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="12">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="8" Background="{Binding Art, IsAsync=True, FallbackValue={StaticResource ArtPlaceholder}}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource Mute}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Style="{StaticResource IconBtn}" Content="&#xE768;" ToolTip="Tocar" Click="QueuePlay_Click"/>
                          <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="Remover da fila" Click="QueueRemove_Click"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="QueueEmpty" Text="A fila está vazia. Use o menu de uma faixa para adicioná-la." Foreground="{StaticResource Mute}" FontSize="15" Margin="2,10,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
          </Grid>

          <!-- Playlists salvas -->
          <Grid x:Name="PlaylistView" Visibility="Collapsed" Margin="40,18,24,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,16,22">
              <StackPanel>
                <TextBlock Text="Playlists" FontSize="40" FontWeight="SemiBold"/>
                <TextBlock Text="Coleções salvas para ouvir novamente" FontSize="17" FontWeight="SemiBold" Margin="2,26,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0">
                <Button x:Name="PlAutoBtn" Style="{StaticResource PillBtn}" Content="Música automática: ligada" ToolTip="Liga ou desliga a fila inteligente (escolhe e baixa músicas pelo seu gosto)" Click="PlAuto_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource PillBtn}" Content="Exportar .m3u" ToolTip="Salva a playlist selecionada como arquivo .m3u (backup)" Click="ExportPlaylist_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource PillBtn}" Content="Salvar fila como playlist" Click="SaveQueue_Click"/>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <ListBox x:Name="PlaylistList" VirtualizingPanel.ScrollUnit="Pixel" Height="300" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Foam}"
                         FocusVisualStyle="{x:Null}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Playlist_SelectionChanged">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="OverridesDefaultStyle" Value="True"/>
                      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                      <Setter Property="Foreground" Value="{StaticResource Foam}"/>
                      <Setter Property="FontSize" Value="14"/>
                      <Setter Property="Cursor" Value="Hand"/>
                      <Setter Property="Margin" Value="0,0,0,10"/>
                      <Setter Property="ContextMenu" Value="{StaticResource PlaylistMenu}"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bd" Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="12" SnapsToDevicePixels="True">
                              <DockPanel>
                                <Border Width="36" Height="36" CornerRadius="8" Background="#332F8CFF" DockPanel.Dock="Left">
                                  <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
                              </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/></Trigger>
                              <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A2F8CFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4FD1FF"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                </ListBox>
                <Button Style="{StaticResource PillBtn}" Content="Reproduzir playlist" Margin="0,12,0,0" Click="PlayPlaylist_Click"/>
                <Button Style="{StaticResource PillBtn}" Content="Adicionar à fila" Margin="0,8,0,0" Click="AddPlaylistToQueue_Click"/>
                <Button Style="{StaticResource PillBtn}" Content="Renomear playlist" Margin="0,8,0,0" Click="RenamePlaylist_Click"/>
                <Button Style="{StaticResource PillBtn}" Content="Excluir playlist" Margin="0,8,0,0" Click="DeletePlaylist_Click"/>
              </StackPanel>
              <ListBox x:Name="PlaylistTracks" VirtualizingPanel.ScrollUnit="Pixel" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Foam}" FocusVisualStyle="{StaticResource FocusRing}"
                       MouseDoubleClick="PlaylistTrack_DoubleClick">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource ItemSoft}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,16,10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="12">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="8" Background="{Binding Art, IsAsync=True, FallbackValue={StaticResource ArtPlaceholder}}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource Mute}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Style="{StaticResource IconBtn}" Content="&#xE768;" ToolTip="Tocar" Click="PlaylistTrackPlay_Click"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>

          <!-- Artistas e álbuns -->
          <Grid x:Name="GroupView" Visibility="Collapsed" Margin="40,18,24,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,16,22">
              <TextBlock x:Name="GroupTitle" Text="Artistas" FontSize="40" FontWeight="SemiBold"/>
              <TextBlock x:Name="GroupSub" Text="" FontSize="17" FontWeight="SemiBold" Margin="2,26,0,0"/>
            </StackPanel>
            <ListBox x:Name="GroupList" VirtualizingPanel.ScrollUnit="Pixel" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Foam}" FocusVisualStyle="{x:Null}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ItemPlain}">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderThickness" Value="0"/>
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0,0,16,10"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Button Click="Group_Click" Cursor="Hand" Foreground="{StaticResource Foam}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" FocusVisualStyle="{x:Null}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="12">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Width="48" Height="48" CornerRadius="{Binding ArtRadius}" Background="{Binding Art, IsAsync=True, FallbackValue={StaticResource ArtPlaceholder}}"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource Mute}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE768;" ToolTip="Tocar tudo" VerticalAlignment="Center" Click="GroupPlay_Click"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="GroupEmpty" Grid.Row="1" Visibility="Collapsed" Foreground="{StaticResource Mute}" FontSize="14" TextWrapping="Wrap" Margin="2,10,0,0"/>
          </Grid>

          <!-- Configurações -->
          <Grid x:Name="SettingsView" Visibility="Collapsed" Margin="40,18,24,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,16,22">
              <TextBlock Text="Configurações" FontSize="40" FontWeight="SemiBold"/>
              <TextBlock Text="Personalize o Azul Groove Music" FontSize="17" FontWeight="SemiBold" Margin="2,26,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <StackPanel Margin="0,0,16,24" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Aparência" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="2,0,0,8"/>
                <Border Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="Animações de fundo" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="Luzes em movimento e ondas do Início. Desligue para economizar bateria e processador." FontSize="12" Foreground="{StaticResource Mute}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="PrefAnim" Grid.Column="1" Style="{StaticResource Toggle}" Click="PrefAnim_Click"/>
                  </Grid>
                </Border>
                <Border Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="Modo leve" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="Desliga as animações de fundo e deixa o visualizador mais simples. Bom para PC fraco ou notebook na bateria." FontSize="12" Foreground="{StaticResource Mute}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="PrefLight" Grid.Column="1" Style="{StaticResource Toggle}" Click="PrefLight_Click"/>
                  </Grid>
                </Border>
                <TextBlock Text="Reprodução" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="2,10,0,8"/>
                <Border Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="Continuar de onde parou" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="Ao abrir o app, volta para a última faixa e posição." FontSize="12" Foreground="{StaticResource Mute}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="PrefResume" Grid.Column="1" Style="{StaticResource Toggle}" Click="PrefResume_Click"/>
                  </Grid>
                </Border>
                <Border Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="Colocar músicas novas no player" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="Música baixada do YouTube ou copiada para uma pasta da biblioteca entra sozinha na fila (e já toca, se o player estiver parado)." FontSize="12" Foreground="{StaticResource Mute}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="PrefAutoQueue" Grid.Column="1" Style="{StaticResource Toggle}" Click="PrefAutoQueue_Click"/>
                  </Grid>
                </Border>
                <Border Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="Fila inteligente" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="A cada troca de música, o app escolhe sozinho a próxima e coloca na fila, aprendendo com o que você mais ouve, em que hora ouve e o que você pula." FontSize="12" Foreground="{StaticResource Mute}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="PrefSmart" Grid.Column="1" Style="{StaticResource Toggle}" Click="PrefSmart_Click"/>
                  </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Button x:Name="PrefSmartAheadBtn" Style="{StaticResource PillBtn}" Content="Músicas à frente: 2" ToolTip="Quantas músicas a fila inteligente mantém prontas" Click="PrefSmartAhead_Click"/>
                </StackPanel>
                <Border Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="Baixar músicas novas do YouTube" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="A fila inteligente também baixa sozinha músicas que você ainda não tem, parecidas com as que você mais ouve, e coloca como a próxima da fila. Salva em Audio\Automatico (máx. 60). Usa a internet; desligue se não quiser." FontSize="12" Foreground="{StaticResource Mute}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="PrefSmartDl" Grid.Column="1" Style="{StaticResource Toggle}" Click="PrefSmartDl_Click"/>
                  </Grid>
                </Border>
                <Border Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="Nivelar volume entre músicas" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="Evita que uma música toque bem mais alto que a outra. Vale depois de reiniciar o app." FontSize="12" Foreground="{StaticResource Mute}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="PrefLevel" Grid.Column="1" Style="{StaticResource Toggle}" Click="PrefLevel_Click"/>
                  </Grid>
                </Border>
                <TextBlock Text="Busca" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="2,10,0,8"/>
                <Border Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="Buscar também no YouTube" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="Ao pesquisar, mostra resultados do YouTube e deixa baixar a música (MP3) ou o vídeo para o aparelho. Usa a internet e envia o texto da busca ao YouTube." FontSize="12" Foreground="{StaticResource Mute}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="PrefYtSearch" Grid.Column="1" Style="{StaticResource Toggle}" Click="PrefYtSearch_Click"/>
                  </Grid>
                </Border>
                <TextBlock Text="Sistema" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="2,10,0,8"/>
                <Border Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="Minimizar para a bandeja" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="Ao minimizar, a janela some e a música continua tocando pelo ícone da bandeja." FontSize="12" Foreground="{StaticResource Mute}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="PrefTray" Grid.Column="1" Style="{StaticResource Toggle}" Click="PrefTray_Click"/>
                  </Grid>
                </Border>
                <Border Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="Iniciar com o Windows" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="Abre o Azul Groove Music quando você entrar no Windows." FontSize="12" Foreground="{StaticResource Mute}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="PrefStartup" Grid.Column="1" Style="{StaticResource Toggle}" Click="PrefStartup_Click"/>
                  </Grid>
                </Border>
                <Border Background="#1BFFFFFF" BorderBrush="#2678AAFF" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="Teclas de mídia em qualquer lugar" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="Play/pausa, próxima e anterior do teclado funcionam mesmo com o app minimizado na bandeja." FontSize="12" Foreground="{StaticResource Mute}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="PrefMediaKeys" Grid.Column="1" Style="{StaticResource Toggle}" Click="PrefMediaKeys_Click"/>
                  </Grid>
                </Border>
                <TextBlock Text="Dados" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" Margin="2,10,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Button Style="{StaticResource PillBtn}" Content="Pasta de downloads" ToolTip="Onde as músicas e vídeos baixados do YouTube são salvos" Click="PrefYtFolder_Click" Margin="0,0,10,0"/>
                  <Button Style="{StaticResource PillBtn}" Content="Abrir pasta de dados" Click="PrefDataFolder_Click" Margin="0,0,10,0"/>
                  <Button Style="{StaticResource PillBtn}" Content="Limpar cache da busca" ToolTip="Apaga as buscas do YouTube salvas no aparelho" Click="PrefYtCacheClear_Click" Margin="0,0,10,0"/>
                  <Button Style="{StaticResource PillBtn}" Content="Restaurar padrões" Click="PrefReset_Click"/>
                </StackPanel>
                <TextBlock x:Name="PrefYtFolderTxt" FontSize="12" Foreground="{StaticResource Mute}" TextWrapping="Wrap" Margin="2,2,0,0"/>
                <TextBlock x:Name="AboutTxt" FontSize="12" Foreground="{StaticResource Mute}" Margin="2,14,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- YouTube: sincronizar playlists -->
          <Grid x:Name="YtView" Visibility="Collapsed" Margin="40,18,24,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,16,22">
              <TextBlock Text="YouTube" FontSize="40" FontWeight="SemiBold"/>
              <TextBlock Text="Sincronize playlists do YouTube e do YouTube Music" FontSize="17" FontWeight="SemiBold" Margin="2,26,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,16,24" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Text="Links das playlists (um por linha)" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,8"/>
                <Border CornerRadius="12" Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                  <TextBox x:Name="YtLinks" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="110" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                           Background="Transparent" BorderThickness="0" Foreground="{StaticResource Foam}" CaretBrush="{StaticResource Cyan}" Padding="12,10"
                           FocusVisualStyle="{StaticResource FocusRing}"/>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <ComboBox x:Name="YtMode" Width="190" Height="36" SelectedIndex="0" FocusVisualStyle="{StaticResource FocusRing}">
                    <ComboBoxItem Content="Áudio (MP3)"/>
                    <ComboBoxItem Content="Vídeo (MP4)"/>
                  </ComboBox>
                  <Button Style="{StaticResource PillBtn}" Content="Escolher pasta" Margin="12,0,0,0" Click="YtFolder_Click"/>
                </StackPanel>
                <TextBlock x:Name="YtFolder" FontSize="12.5" Foreground="{StaticResource Mute}" Margin="2,10,0,0" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                  <Button x:Name="YtTestBtn" Style="{StaticResource PillBtn}" Content="Testar link" Padding="22,10" Click="YtTest_Click"/>
                  <Button x:Name="YtSyncBtn" Style="{StaticResource PillBtn}" Content="Sincronizar" Padding="28,10" Margin="12,0,0,0" Click="YtSync_Click"/>
                  <Button x:Name="YtCancelBtn" Style="{StaticResource PillBtn}" Content="Cancelar" Margin="12,0,0,0" Visibility="Collapsed" Click="YtCancel_Click"/>
                </StackPanel>
                <ProgressBar x:Name="YtBar" Height="8" Margin="0,18,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                <TextBlock x:Name="YtStatus" FontSize="13.5" TextWrapping="Wrap" Margin="2,12,0,0"/>
                <TextBox x:Name="YtLog" IsReadOnly="True" MinHeight="150" MaxHeight="260" Margin="0,14,0,0" Padding="10,8" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         Background="#26000822" BorderBrush="#26FFFFFF" BorderThickness="1" Foreground="{StaticResource Mute}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Style="{StaticResource PillBtn}" Content="Abrir logs" Padding="18,8" Click="YtOpenLogs_Click"/>
                  <Button Style="{StaticResource PillBtn}" Content="Copiar log" Padding="18,8" Margin="12,0,0,0" Click="YtCopyLog_Click"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Mute}" Margin="2,14,0,0"
                           Text="Na primeira vez o app baixa o yt-dlp e o ffmpeg (cerca de 100 MB). Use apenas com conteúdo que você tem direito de baixar; o download pode ir contra os termos de uso do YouTube."/>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- Tocando agora -->
          <Grid x:Name="PlayerView" Visibility="Collapsed" Margin="-16,-18,-8,0">
            <Grid x:Name="VideoHost" Background="Black"/>
            <StackPanel x:Name="AudioPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Grid Width="300" Height="300" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="DiscScale"/><RotateTransform x:Name="DiscRot"/></TransformGroup></Grid.RenderTransform>
                <Grid.CacheMode><BitmapCache/></Grid.CacheMode>
                <Ellipse Fill="#0A1F4D" Stroke="#552F8CFF" StrokeThickness="3"/>
                <Ellipse Width="280" Height="280" Stroke="#222F8CFF" StrokeThickness="1.5"/>
                <Ellipse Width="250" Height="250" Stroke="#1E4FD1FF" StrokeThickness="1.5"/>
                <Ellipse Width="220" Height="220" Stroke="#222F8CFF" StrokeThickness="1.5"/>
                <Ellipse Width="190" Height="190" Stroke="#1E4FD1FF" StrokeThickness="1.5"/>
                <Ellipse Width="160" Height="160" Stroke="#222F8CFF" StrokeThickness="1.5"/>
                <Ellipse Width="126" Height="126" Fill="{StaticResource Grad}"/>
                <TextBlock x:Name="DiscLabel" Text="♪" FontSize="46" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="12" Height="12" Fill="White" VerticalAlignment="Top" Margin="0,22,0,0" Opacity="0.8"/>
              </Grid>
              <TextBlock x:Name="PlayerTitle" Text="Nenhuma faixa" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,34,0,6" MaxWidth="700" TextTrimming="CharacterEllipsis"/>
              <StackPanel x:Name="Bars" Orientation="Horizontal" Height="96" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,12,0,0"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>

      <!-- Barra de reprodução -->
      <Border x:Name="Bar" Grid.Row="2" Background="#EA061431" BorderBrush="#2078AAFF" BorderThickness="0,1,0,0" Padding="24,10,24,14">
        <Border.RenderTransform><TranslateTransform x:Name="BarShift"/></Border.RenderTransform>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="CurT" Text="0:00" Foreground="{StaticResource Mute}" FontSize="12" VerticalAlignment="Center"/>
            <Slider x:Name="Seek" Grid.Column="1" Style="{StaticResource Bar}" Minimum="0" Maximum="1"/>
            <TextBlock x:Name="DurT" Grid.Column="2" Text="0:00" Foreground="{StaticResource Mute}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
              <Button x:Name="MiniBtn" Width="64" Height="64" Cursor="Hand" Click="Mini_Click" Background="Transparent" BorderThickness="0">
                <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template>
                <Border x:Name="MiniArt" Width="64" Height="64" CornerRadius="12" Background="#0E2A5C" RenderTransformOrigin="0.5,0.5">
                  <Border.RenderTransform><ScaleTransform x:Name="MiniScale"/></Border.RenderTransform>
                  <TextBlock x:Name="MiniGlyph" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#77FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Button>
              <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock x:Name="NowTitle" Text="Nenhuma faixa" FontSize="16" FontWeight="SemiBold" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NowDetails" Text="" FontSize="11.5" Foreground="{StaticResource Mute}" MaxWidth="280" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                <Border x:Name="ChipRes" Visibility="Collapsed" Background="{StaticResource Grad}" CornerRadius="7" Padding="9,2" Margin="0,6,0,0" HorizontalAlignment="Left">
                  <TextBlock x:Name="ChipTxt" FontSize="11.5" FontWeight="Bold" Foreground="#04122B"/>
                </Border>
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ShufBtn" Style="{StaticResource IconBtn}" Content="&#xE8B1;" Click="Shuf_Click" ToolTip="Aleatório (S)"/>
              <Button Style="{StaticResource IconBtn}" Content="&#xED3C;" Click="Back10_Click" ToolTip="Voltar 10 s (J)" Margin="4,0"/>
              <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Click="Prev_Click" ToolTip="Anterior (P)" Margin="4,0"/>
              <Grid Width="66" Height="66" Margin="6,0">
                <Ellipse Width="64" Height="64" StrokeThickness="3.5" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#4FD1FF" Offset="0"/><GradientStop Color="#2F8CFF" Offset="0.5"/><GradientStop Color="#0F2A66" Offset="1"/>
                    </LinearGradientBrush>
                  </Ellipse.Stroke>
                  <Ellipse.RenderTransform><RotateTransform x:Name="RingRot"/></Ellipse.RenderTransform>
                </Ellipse>
                <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Width="52" Height="52" FontSize="21" Background="{StaticResource Grad}" Content="&#xE768;" Click="Play_Click" ToolTip="Reproduzir / Pausar (Espaço)"/>
              </Grid>
              <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Click="Next_Click" ToolTip="Próxima (N)" Margin="4,0"/>
              <Button Style="{StaticResource IconBtn}" Content="&#xED3D;" Click="Fwd_Click" ToolTip="Avançar 30 s (L)" Margin="4,0"/>
              <Button x:Name="RepBtn" Style="{StaticResource IconBtn}" Content="&#xE8EE;" Click="Rep_Click" ToolTip="Repetir (R)"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="SpdBtn" Style="{StaticResource IconBtn}" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Width="54" Height="34" Content="1x" Click="Spd_Click" ToolTip="Velocidade (+ / -)"/>
              <Button x:Name="MuteBtn" Style="{StaticResource IconBtn}" Content="&#xE995;" Click="Mute_Click" PreviewMouseWheel="Vol_Wheel" ToolTip="Mudo (M)" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform><ScaleTransform x:Name="MuteScale"/></Button.RenderTransform>
              </Button>
              <Slider x:Name="VolSlider" Style="{StaticResource Bar}" Width="100" Minimum="0" Maximum="100" Value="80" ValueChanged="Vol_Changed" PreviewMouseWheel="Vol_Wheel" ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0}%}" Margin="2,0,10,0"/>
              <Button x:Name="MoreBtn" Style="{StaticResource IconBtn}" Content="&#xE712;" Click="More_Click" ToolTip="Mais opções"/>
              <Button Style="{StaticResource IconBtn}" Content="&#xE740;" Click="Full_Click" ToolTip="Tela cheia (F)"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Popup x:Name="SpdPop" PlacementTarget="{Binding ElementName=SpdBtn}" Placement="Top" VerticalOffset="-10" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" Opened="Pop_Opened">
        <Border Background="#F20A1F4A" BorderBrush="#554F8CFF" BorderThickness="1" CornerRadius="14" Padding="8" RenderTransformOrigin="0.5,1">
          <Border.RenderTransform><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Border.RenderTransform>
          <UniformGrid x:Name="SpdGrid" Columns="2" Width="200"/>
        </Border>
      </Popup>
      <Popup x:Name="MorePop" PlacementTarget="{Binding ElementName=MoreBtn}" Placement="Top" VerticalOffset="-10" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" Opened="Pop_Opened">
        <Border Background="#F20A1F4A" BorderBrush="#554F8CFF" BorderThickness="1" CornerRadius="14" Padding="8" RenderTransformOrigin="0.5,1">
          <Border.RenderTransform><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></Border.RenderTransform>
          <StackPanel Width="300">
            <Button Style="{StaticResource MenuBtn}" Click="Aspect_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE799;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Cyan}" Width="28" VerticalAlignment="Center"/><TextBlock x:Name="AspectTxt" Foreground="{StaticResource Foam}" Text="Proporção da tela: Auto"/></StackPanel></Button>
            <Button Style="{StaticResource MenuBtn}" Click="Sub_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F0;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Cyan}" Width="28" VerticalAlignment="Center"/><TextBlock Foreground="{StaticResource Foam}" Text="Alternar legenda"/></StackPanel></Button>
            <Button Style="{StaticResource MenuBtn}" Click="Audio_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Cyan}" Width="28" VerticalAlignment="Center"/><TextBlock Foreground="{StaticResource Foam}" Text="Alternar faixa de áudio"/></StackPanel></Button>
            <Button Style="{StaticResource MenuBtn}" Click="ExternalSubtitle_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Cyan}" Width="28" VerticalAlignment="Center"/><TextBlock Foreground="{StaticResource Foam}" Text="Abrir legenda .srt"/></StackPanel></Button>
            <Button Style="{StaticResource MenuBtn}" Click="Sleep_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Cyan}" Width="28" VerticalAlignment="Center"/><TextBlock x:Name="SleepTxt" Foreground="{StaticResource Foam}" Text="Temporizador: desligado"/></StackPanel></Button>
            <TextBlock Text="Saída de áudio" Foreground="{StaticResource Mute}" Margin="10,8,0,4"/>
            <ComboBox x:Name="AudioOutputBox" Height="32" FocusVisualStyle="{StaticResource FocusRing}" SelectionChanged="AudioOutput_Changed" ToolTip="Dispositivo de saída de áudio"/>
            <TextBlock Text="Equalizador VLC" Foreground="{StaticResource Mute}" Margin="10,10,0,4"/>
            <ComboBox x:Name="EqPresetBox" Height="32" FocusVisualStyle="{StaticResource FocusRing}" SelectionChanged="EqPreset_Changed"/>
            <Expander Header="Ajuste manual" Foreground="{StaticResource Foam}" Margin="8,6,0,0">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="EqBandsPanel" Orientation="Horizontal" Margin="4,8"/>
              </ScrollViewer>
            </Expander>
          </StackPanel>
        </Border>
      </Popup>
      <Popup x:Name="ToastPop" PlacementTarget="{Binding ElementName=Root}" Placement="Center" VerticalOffset="-220" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" IsHitTestVisible="False">
        <Border Background="#E60A1F4A" BorderBrush="#664FD1FF" BorderThickness="1" CornerRadius="12" Padding="22,10">
          <TextBlock x:Name="ToastTxt" Foreground="{StaticResource Foam}" FontSize="16" FontWeight="SemiBold" MaxWidth="600" TextTrimming="CharacterEllipsis"/>
        </Border>
      </Popup>
    </Grid>
  </Grid>
</Window>
